# syntax=docker/dockerfile:1
# Image für ems-core (Phase 1a: nur beobachten). Bauen aus dem Repository-Wurzelverzeichnis:
#   docker build -f deploy/Dockerfile.core -t bindaems-core:dev .
FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Abhängigkeiten zuerst (eigene Schicht, bleibt bei Codeänderungen im Cache)
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --extra core --no-install-project

COPY src ./src
RUN uv sync --locked --no-dev --extra core --no-editable

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin ems \
    && mkdir -p /data \
    && chown ems:ems /data

USER ems
VOLUME /data

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-m", "bindaems.core.healthcheck"]

ENTRYPOINT ["python", "-m", "bindaems.core"]
CMD ["--config", "/config/config.yaml"]
