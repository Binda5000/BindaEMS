# Secrets für BindaEMS. Als `.env` neben docker-compose.yml ablegen und mit `chmod 600 .env` schützen.
# Diese Datei niemals mit echten Werten ins Repository committen.
# Pflicht, mindestens 32 Zeichen, z. B. erzeugt mit: openssl rand -hex 32
BINDAEMS_INTERNAL_TOKEN=
BINDAEMS_MQTT_PASSWORD=
BINDAEMS_TESSIE_TOKEN=
BINDAEMS_HA_TOKEN=
BINDAEMS_INFLUX_PASSWORD=
BINDAEMS_HA_MQTT_PASSWORD=

# Optional: Image-Version für Update/Rollback, z. B. v0.1.0 oder sha-1234567 (Standard: latest)
# BINDAEMS_VERSION=latest
# Optional: Port der internen API für den Healthcheck, falls core_api.port geändert wurde
# BINDAEMS_CORE_PORT=8081
# Optional: Port der app für den Healthcheck, falls app.port geändert wurde
# BINDAEMS_APP_PORT=8080
